APP_ENV=production

POSTGRES_DB=medistock
POSTGRES_USER=medistock_prod
POSTGRES_PASSWORD=replace_with_strong_db_password

# Use asyncpg URL for app, standard URL for migrate script
DATABASE_URL=postgresql+asyncpg://medistock_prod:replace_with_strong_db_password@postgres:5432/medistock

CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1
CACHE_URL=redis://valkey:6379/2

JWT_SECRET=replace_with_long_random_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

FRONTEND_URL=https://app.medistock.com

EMAIL_FROM=noreply@medistock.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=replace_with_smtp_password
