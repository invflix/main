APP_ENV=development

POSTGRES_DB=medistock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/medistock
# Local non-docker backup URL if needed (uncomment/edit for localhost):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medistock

CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/1
CACHE_URL=redis://valkey:6379/2

JWT_SECRET=supersecretjwtkeyforlocaldevelopmentonly123!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:3000

EMAIL_FROM=noreply@medistock.local
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
